{
  "name": "@w3-kit/registry",
  "version": "0.2.0",
  "description": "Chain, token, and ABI registry for web3 development",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./data/chains.json": "./data/chains.json",
    "./data/solana-programs.json": "./data/solana-programs.json",
    "./data/tokens.json": "./data/tokens.json"
  },
  "files": [
    "dist",
    "data"
  ],
  "scripts": {
    "clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean:dist && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "validate": "vitest run tests/validation",
    "lint": "eslint src/",
    "format:check": "prettier --check src/",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@w3-kit/config": "^0.1.0",
    "eslint": "^10.2.0",
    "prettier": "^3.8.1",
    "typescript": "^5.3.3",
    "vitest": "^3.1.1",
    "zod": "^4.1.12"
  },
  "license": "MIT"
}
